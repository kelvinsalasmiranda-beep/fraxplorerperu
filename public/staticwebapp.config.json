{
  "routes": [
    { "route": "/inicio", "redirect": "/", "statusCode": 301 },
    { "route": "/inicio/*", "redirect": "/", "statusCode": 301 },
    { "route": "/home", "redirect": "/", "statusCode": 301 },
    { "route": "/home/*", "redirect": "/", "statusCode": 301 },
    { "route": "/index.php", "redirect": "/", "statusCode": 301 },
    { "route": "/es", "redirect": "/", "statusCode": 301 },
    { "route": "/es/*", "redirect": "/", "statusCode": 301 },
    { "route": "/en", "redirect": "/", "statusCode": 301 },
    { "route": "/en/*", "redirect": "/", "statusCode": 301 },
    { "route": "/paquetes", "redirect": "/", "statusCode": 301 },
    { "route": "/paquetes/*", "redirect": "/", "statusCode": 301 },
    { "route": "/machupicchu", "redirect": "/tours/tour-machu-picchu-full-day/", "statusCode": 301 },
    { "route": "/machupicchu/*", "redirect": "/tours/tour-machu-picchu-full-day/", "statusCode": 301 },
    { "route": "/tour-en-cusco", "redirect": "/", "statusCode": 301 },
    { "route": "/tour-en-cusco/*", "redirect": "/", "statusCode": 301 },
    { "route": "/camino-inca", "redirect": "/tours/camino-inca-4d-3n/", "statusCode": 301 },
    { "route": "/camino-inca/*", "redirect": "/tours/camino-inca-4d-3n/", "statusCode": 301 },
    { "route": "/salkantay-y-otros", "redirect": "/tours/salkantay-trek-machupicchu-5d-4n/", "statusCode": 301 },
    { "route": "/otros-destinos", "redirect": "/", "statusCode": 301 },
    { "route": "/machu-picchu-full-day", "redirect": "/tours/tour-machu-picchu-full-day/", "statusCode": 301 },
    { "route": "/nosotros", "redirect": "/sobre-nosotros/", "statusCode": 301 },
    { "route": "/contacto", "redirect": "/", "statusCode": 301 }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()",
    "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
    "X-Permitted-Cross-Domain-Policies": "none",
    "Content-Security-Policy": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  }
}
